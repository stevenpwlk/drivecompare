+    def login(
+        self,
+        page: Page,
+        email: str,
+        password: str,
+        auth_url: str | None = None,
+        verify_url: str | None = None,
+        save_storage_state: bool = True,
+    ) -> dict:
+        """Login sur l'espace client E.Leclerc et persiste la session via le profil Chromium partagé.
+
+        Note: on n'essaie PAS de contourner un éventuel challenge anti-bot (DataDome/CAPTCHA).
+        Si un challenge apparaît, on renvoie un statut "blocked" et on demande une validation manuelle via l'UI (port 5800).
+        """
+
+        auth_url = auth_url or os.getenv("LECLERC_AUTH_URL") or ""
+        if not auth_url:
+            return {"ok": False, "error": "missing_auth_url"}
+
+        page.goto(auth_url, wait_until="domcontentloaded", timeout=DEFAULT_TIMEOUT_MS)
+        self._accept_cookie_banner(page)
+
+        if self._is_datadome_blocked(page):
+            self._handle_datadome_block(page, "login")
+            return {"ok": False, "error": "blocked", "blocked": True, "url": page.url}
+
+        def _fill_first(selectors: list[str], value: str) -> bool:
+            for sel in selectors:
+                try:
+                    loc = page.locator(sel).first
+                    if loc.count() and loc.is_visible():
+                        loc.click(timeout=2000)
+                        loc.fill(value, timeout=5000)
+                        return True
+                except Exception:
+                    continue
+            return False
+
+        email_ok = _fill_first(
+            [
+                "input[type='email']",
+                "input[name*='mail' i]",
+                "input[id*='mail' i]",
+                "input[name*='login' i]",
+                "input[id*='login' i]",
+                "input[name*='ident' i]",
+                "input[id*='ident' i]",
+            ],
+            email,
+        )
+        page.wait_for_timeout(250)
+
+        pwd_ok = _fill_first(
+            [
+                "input[type='password']",
+                "input[name*='pass' i]",
+                "input[id*='pass' i]",
+            ],
+            password,
+        )
+        page.wait_for_timeout(250)
+
+        if not email_ok or not pwd_ok:
+            self._save_debug_artifacts(page, "login_missing_fields")
+            return {
+                "ok": False,
+                "error": "login_form_not_found",
+                "url": page.url,
+                "email_field": email_ok,
+                "password_field": pwd_ok,
+            }
+
+        submitted = False
+        for sel in [
+            "button[type='submit']",
+            "input[type='submit']",
+            "button:has-text('Se connecter')",
+            "button:has-text('Connexion')",
+            "button:has-text('Valider')",
+        ]:
+            try:
+                loc = page.locator(sel).first
+                if loc.count() and loc.is_visible():
+                    loc.click(timeout=5000)
+                    submitted = True
+                    break
+            except Exception:
+                continue
+
+        if not submitted:
+            self._save_debug_artifacts(page, "login_no_submit")
+            return {"ok": False, "error": "login_submit_not_found", "url": page.url}
+
+        try:
+            page.wait_for_load_state("domcontentloaded", timeout=DEFAULT_TIMEOUT_MS)
+        except Exception:
+            pass
+
+        if self._is_datadome_blocked(page):
+            self._handle_datadome_block(page, "login_after_submit")
+            return {"ok": False, "error": "blocked", "blocked": True, "url": page.url}
+
+        logged_in = True
+        if verify_url:
+            try:
+                page.goto(verify_url, wait_until="domcontentloaded", timeout=DEFAULT_TIMEOUT_MS)
+                self._accept_cookie_banner(page)
+                if "authentification.aspx" in page.url.lower():
+                    logged_in = False
+            except Exception:
+                logged_in = False
+        else:
+            if "authentification.aspx" in page.url.lower():
+                logged_in = False
+
+        if save_storage_state:
+            try:
+                state_path = "/sessions/leclerc/storage_state.json"
+                os.makedirs(os.path.dirname(state_path), exist_ok=True)
+                page.context.storage_state(path=state_path)
+            except Exception:
+                pass
+
+        return {
+            "ok": True,
+            "logged_in": logged_in,
+            "url": page.url,
+            "title": page.title(),
+        }
+
+    def _save_debug_artifacts(self, page: Page, tag: str) -> None:
+        """Sauvegarde screenshot + html dans /logs pour faciliter le debug."""
+        try:
+            ts = int(time.time())
+            base = f"/logs/leclerc_{tag}_{ts}"
+            page.screenshot(path=f"{base}.png", full_page=True)
+            html = page.content()
+            with open(f"{base}.html", "w", encoding="utf-8") as f:
+                f.write(html)
+        except Exception:
+            pass
+
